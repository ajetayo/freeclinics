---
// ZIP / city search box. Submits to /near-me/?q=..., which does the lookup in
// the browser, so the form also works as a plain link without JavaScript on
// this page.
export interface Props {
  /** Pre-filled query (the near-me page passes the current search). */
  value?: string;
  /** Show the "Use my location" button (near-me page only). */
  withLocation?: boolean;
}
const { value = '', withLocation = false } = Astro.props as Props;
---
<form class="clinic-search" action="/near-me/" method="get" role="search" aria-label="Find clinics near you">
  <label for="clinic-search-q" class="clinic-search__label">Find free clinics near you</label>
  <div class="clinic-search__row">
    <input
      id="clinic-search-q"
      name="q"
      type="search"
      inputmode="search"
      autocomplete="postal-code"
      placeholder="ZIP code or city, e.g. 30310 or Tulsa, OK"
      value={value}
      required
      class="clinic-search__input"
    />
    <button type="submit" class="clinic-search__button">Search</button>
  </div>
  {withLocation && (
    <button type="button" class="clinic-search__locate" id="use-my-location" hidden>
      Use my location
    </button>
  )}
</form>

<style>
  .clinic-search {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4);
    margin: var(--space-4) 0 var(--space-5);
  }
  .clinic-search__label {
    display: block;
    font-weight: 700;
    margin-bottom: var(--space-2);
  }
  .clinic-search__row {
    display: flex;
    gap: var(--space-2);
  }
  .clinic-search__input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    padding: 0 var(--space-3);
    font-size: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .clinic-search__button,
  .clinic-search__locate {
    min-height: 48px;
    padding: 0 var(--space-4);
    font-size: 1rem;
    font-weight: 600;
    border-radius: var(--radius);
    cursor: pointer;
  }
  .clinic-search__button {
    background: var(--color-primary);
    color: #fff;
    border: none;
  }
  .clinic-search__button:hover { background: var(--color-primary-dark); }
  .clinic-search__locate {
    margin-top: var(--space-3);
    background: transparent;
    color: var(--color-primary);
    border: 1px solid var(--color-primary);
    width: 100%;
  }
</style>
