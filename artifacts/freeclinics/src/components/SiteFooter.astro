---
// Site-wide footer. No links (we have no About/Contact pages yet). The
// per-page "last verified" date and editorial note live on each page's own
// .page-footer — this is just the trust + copyright strip at the bottom of
// every layout.
const currentYear = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <p class="site-footer__brand">freeclinics.us</p>
    <p class="site-footer__mission">
      A directory of free and low-cost health clinics across the United States.
    </p>
    <p class="site-footer__trust">
      Listings are reviewed and verified by our editorial team.
    </p>
    <p class="site-footer__copyright">© {currentYear} freeclinics.us</p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    margin-top: var(--space-7);
  }
  .site-footer__inner {
    max-width: var(--max-width-wide);
    margin: 0 auto;
    padding: var(--space-5) var(--space-4);
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }
  .site-footer__brand {
    color: var(--color-text);
    font-weight: 700;
    margin: 0 0 var(--space-1);
  }
  .site-footer__mission,
  .site-footer__trust { margin: 0 0 var(--space-1); }
  .site-footer__copyright {
    margin: var(--space-3) 0 0;
    font-size: 0.85rem;
  }
</style>
