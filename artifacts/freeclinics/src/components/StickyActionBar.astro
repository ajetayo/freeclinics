---
// Bottom-of-screen "Call" / "Directions" bar for clinic pages on phones.
// Hidden on wider screens, where the contact card is already in view. Renders
// nothing when the clinic has neither a phone number nor an address. The page
// gets matching bottom padding (only when the bar is present) so the footer
// never sits under it.
export interface Props {
  phone: string | null;
  directionsHref: string | null;
  clinicSlug: string;
  clinicName: string;
}
const { phone, directionsHref, clinicSlug, clinicName } = Astro.props as Props;
const telHref = phone ? `tel:${phone.replace(/[^0-9+]/g, '')}` : null;
---
{(telHref || directionsHref) && (
  <>
    <nav class="action-bar" aria-label={`Contact ${clinicName}`}>
      {telHref && (
        <a href={telHref} class="action-bar__btn action-bar__btn--call" data-track="phone_call" data-clinic={clinicSlug}>
          Call
        </a>
      )}
      {directionsHref && (
        <a href={directionsHref} rel="noopener" target="_blank" class="action-bar__btn action-bar__btn--directions" data-track="get_directions" data-clinic={clinicSlug}>
          Directions
        </a>
      )}
    </nav>
  </>
)}

<style>
  .action-bar { display: none; }

  @media (max-width: 767px) {
    .action-bar {
      display: flex;
      gap: var(--space-2);
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 50;
      padding: var(--space-2) var(--space-3) calc(var(--space-2) + env(safe-area-inset-bottom, 0px));
      background: var(--color-bg);
      border-top: 1px solid var(--color-border);
      box-shadow: 0 -2px 8px rgba(0, 0, 0, 0.08);
    }
    :global(body:has(.action-bar)) {
      padding-bottom: calc(72px + env(safe-area-inset-bottom, 0px));
    }
    .action-bar__btn {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      border-radius: var(--radius);
      font-size: 1.05rem;
      font-weight: 700;
      text-decoration: none;
    }
    .action-bar__btn--call {
      background: var(--color-primary);
      color: #fff;
    }
    .action-bar__btn--call:hover { background: var(--color-primary-dark); }
    .action-bar__btn--directions {
      background: var(--color-bg);
      color: var(--color-primary);
      border: 2px solid var(--color-primary);
    }
  }

  @media (max-width: 767px) and (prefers-reduced-motion: no-preference) {
    .action-bar__btn { transition: background-color 0.15s ease; }
  }
</style>
