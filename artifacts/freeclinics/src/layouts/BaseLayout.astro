---
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AdUnit from '../components/AdUnit.astro';

export interface Props {
  title: string;
  description: string;
  canonicalUrl: string;
  noAds?: boolean;
  /** Ask search engines not to index this page (links on it are still followed). */
  noindex?: boolean;
}

const { title, description, canonicalUrl, noAds = false, noindex = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4183031888320028" crossorigin="anonymous"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-5SW6JT3KD3"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-5SW6JT3KD3');

      // Key events: clicks on links marked data-track="<event name>"
      // (phone_call, get_directions, clinic_website_click) in clinic templates.
      document.addEventListener('click', (e) => {
        const link = e.target instanceof Element ? e.target.closest('a[data-track]') : null;
        if (!link) return;
        gtag('event', link.dataset.track, {
          clinic_slug: link.dataset.clinic,
          link_url: link.href,
          page_type: location.pathname.startsWith('/clinic/') ? 'clinic' : 'service',
        });
      });
    </script>
    <slot name="head" />
  </head>
  <body>
    <SiteHeader />
    <slot />
    {!noAds && <AdUnit />}
    <SiteFooter />
  </body>
</html>
