---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SlidingScaleExplainer from '../../../../components/SlidingScaleExplainer.astro';
import { getState, getServiceDisplayName, toTitleCase } from '../../../../lib/constants';
import type { Clinic } from '../../../../lib/types';
import { getClinicsByCityState, getClinicsByService, getClinicsNearCity } from '../../../../lib/clinics';
import { getServiceCombos } from '../../../../lib/servicePages';
import { SERVICE_FAQS } from '../../../../data/service-faqs';
import serviceTaxonomy from '../../../../data/service-taxonomy.json';

// ---------------------------------------------------------------------------
// Routes — Phase 1
// ---------------------------------------------------------------------------
export function getStaticPaths() {
  const paths: Array<{
    params: { state: string; city: string; service: string };
    props: { clinics: Clinic[] };
  }> = [];

  for (const combo of getServiceCombos()) {
    const cityClinics = getClinicsByCityState(combo.stateSlug, combo.citySlug);
    const matching = getClinicsByService(cityClinics, combo.serviceSlug);

    if (matching.length === 0) {
      console.warn(
        `[freeclinics] skipping empty combo: ${combo.stateSlug}/${combo.citySlug}/${combo.serviceSlug} ` +
          `(city has ${cityClinics.length} clinic(s), none match service)`,
      );
      continue;
    }

    paths.push({
      params: { state: combo.stateSlug, city: combo.citySlug, service: combo.serviceSlug },
      props: { clinics: matching },
    });
  }

  return paths;
}

const { state, city, service } = Astro.params;
const { clinics: rawClinics } = Astro.props as { clinics: Clinic[] };

const clinics = [...rawClinics].sort((a, b) => a.name.localeCompare(b.name));

const stateInfo      = getState(state);
const stateAbbr      = stateInfo?.abbr ?? state.toUpperCase();
const stateName      = stateInfo?.name ?? toTitleCase(state);
const titleCity      = toTitleCase(city);
const displayService = getServiceDisplayName(service);
// Lower-cased for use mid-sentence, keeping acronyms like "STD" or "OB-GYN" as written.
const serviceInText  = displayService.replace(/\b[A-Z][a-z]+\b/g, (w) => w.toLowerCase());

// Other clinics within 25 miles that offer the same service.
const nearby = getClinicsNearCity(state, city, 8, 25, service);

// HIV testing marker on STD-testing pages.
const HIV_TERMS = new Set((serviceTaxonomy as Record<string, string[]>)['hiv-testing'] ?? []);
const testsHiv = (c: Clinic) => service === 'std-testing' && c.services.some((s) => HIV_TERMS.has(s));
const hivCount = clinics.filter(testsHiv).length;

const n = clinics.length;
const clinicWord = n === 1 ? 'clinic' : 'clinics';
const h1            = `Free & Low-Cost ${displayService} Clinics in ${titleCity}, ${stateAbbr}`;
// Titles lead with the search phrase ("STD Testing in Lompoc, CA") and stay <= 60 chars.
const pageTitle     = [
  `${displayService} in ${titleCity}, ${stateAbbr}: ${n} Free & Low-Cost ${n === 1 ? 'Clinic' : 'Clinics'}`,
  `${displayService} in ${titleCity}, ${stateAbbr}: Free & Low-Cost`,
  `${displayService} in ${titleCity}, ${stateAbbr}`,
].find((t) => t.length <= 60) ?? `${displayService} in ${titleCity}, ${stateAbbr}`;
const descriptionCore = `${n} free and low-cost ${clinicWord} offering ${serviceInText} in ${titleCity}, ${stateAbbr}`
  + (nearby.length > 0 ? `, plus ${nearby.length} more within 25 miles` : '');
const description   = [`${descriptionCore}. Phone numbers, hours, fees and eligibility for each.`, `${descriptionCore}.`]
  .find((d) => d.length <= 155) ?? `${descriptionCore}.`;

const ledeText = `${n} ${clinicWord} in ${titleCity} ${n === 1 ? 'offers' : 'offer'} ${serviceInText} on a free or sliding-scale basis, so what you pay depends on your income`
  + (nearby.length > 0 ? `, and ${nearby.length} more within 25 miles ${nearby.length === 1 ? 'is' : 'are'} listed further down` : '')
  + '.'
  + (hivCount > 0 ? ` ${hivCount === n ? (n === 1 ? 'It also tests' : 'All of them also test') : `${hivCount} of them also test`} for HIV.` : '')
  + ' Call ahead to confirm hours and what your visit will cost.';
const canonicalUrl  = `https://freeclinics.us/${state}/${city}/${service}/`;

const faqs = SERVICE_FAQS[service] ?? [];
const hasFaqs = faqs.length > 0;

// ---------------------------------------------------------------------------
// JSON-LD structured data
// ---------------------------------------------------------------------------
// We deliberately emit only a lightweight ItemList here (one ListItem per
// clinic, in render order) rather than a full MedicalBusiness block per
// clinic. The canonical structured data for each clinic lives on its own
// /clinic/<slug>/ page; this list page just tells search engines the order
// and identity of the items shown.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: clinics.map((clinic, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: clinic.name,
    url: `https://freeclinics.us/clinic/${clinic.slug}/`,
  })),
};

// Full breadcrumb chain: Home → State → City → Service.
const stateUrl = `https://freeclinics.us/${state}/`;
const cityUrl  = `https://freeclinics.us/${state}/${city}/`;
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',         item: 'https://freeclinics.us/' },
    { '@type': 'ListItem', position: 2, name: stateName,      item: stateUrl },
    { '@type': 'ListItem', position: 3, name: titleCity,      item: cityUrl },
    { '@type': 'ListItem', position: 4, name: displayService, item: canonicalUrl },
  ],
};

const faqJsonLd = hasFaqs
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;
---
<BaseLayout title={pageTitle} description={description} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </Fragment>

  <main class="site-main site-main--wide">
    <article>
      <p class="breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href={`/${state}/`}>{stateName}</a>
        <span aria-hidden="true">›</span>
        <a href={`/${state}/${city}/`}>{titleCity}</a>
        <span aria-hidden="true">›</span>
        {displayService}
      </p>

      <header class="page-intro">
        <h1>{h1}</h1>
        <p class="lede">{ledeText}</p>
      </header>

      <SlidingScaleExplainer compact />

      <section aria-labelledby="clinic-list">
        <h2 id="clinic-list">{displayService} clinics in {titleCity}, {stateAbbr}</h2>
        <ol class="clinic-list">
          {clinics.map((clinic) => (
            <li class="clinic-card">
              <h3 class="clinic-card__name">
                <a href={`/clinic/${clinic.slug}/`}>{clinic.name}</a>
              </h3>
              {testsHiv(clinic) && <p class="clinic-card__badge">Also tests for HIV</p>}
              <p class="clinic-card__meta">
                <span>
                  {[clinic.streetAddress, clinic.city, clinic.stateAbbr].filter(Boolean).join(', ')}
                  {clinic.postalCode ? ` ${clinic.postalCode}` : ''}
                </span>
                {clinic.phone && (
                  <>
                    {' '}·{' '}
                    <a href={`tel:${clinic.phone.replace(/[^0-9+]/g, '')}`} data-track="phone_call" data-clinic={clinic.slug}>{clinic.phone}</a>
                  </>
                )}
                {clinic.website && (
                  <>
                    {' '}·{' '}
                    <a href={clinic.website} rel="noopener" target="_blank" data-track="clinic_website_click" data-clinic={clinic.slug}>Website</a>
                  </>
                )}
              </p>

              <dl class="clinic-card__details">
                {clinic.services.length > 0 && (<><dt>Services offered</dt><dd><ul>{clinic.services.map((s) => (<li>{s}</li>))}</ul></dd></>)}
                {clinic.languages.length > 0 && (<><dt>Languages spoken</dt><dd>{clinic.languages.join(', ')}</dd></>)}
                {clinic.feeStructure && (<><dt>Fee structure</dt><dd>{clinic.feeStructure}</dd></>)}
                {clinic.incomeEligibility && (<><dt>Income eligibility</dt><dd>{clinic.incomeEligibility}</dd></>)}
                {clinic.insuranceAccepted.length > 0 && (<><dt>Insurance accepted</dt><dd>{clinic.insuranceAccepted.join('; ')}</dd></>)}
                {clinic.hours && (<><dt>Hours</dt><dd>{clinic.hours}</dd></>)}
                {clinic.serviceArea && (<><dt>Service area</dt><dd>{clinic.serviceArea}</dd></>)}
              </dl>
            </li>
          ))}
        </ol>
      </section>

      {nearby.length > 0 && (
        <section aria-labelledby="nearby-service">
          <h2 id="nearby-service">{displayService} near {titleCity}</h2>
          <p>Other free and low-cost clinics offering {serviceInText} within 25 miles, nearest first.</p>
          <ol class="nearby-list">
            {nearby.map(({ clinic: other, miles }) => (
              <li>
                <a href={`/clinic/${other.slug}/`}>{other.name}</a>
                <span class="nearby-list__meta">
                  {other.city}, {other.stateAbbr} · {miles.toFixed(1)} mi
                  {testsHiv(other) ? ' · also tests for HIV' : ''}
                </span>
              </li>
            ))}
          </ol>
          <p><a href={`/${state}/${city}/`}>All free and low-cost clinics in {titleCity}</a></p>
        </section>
      )}

      {hasFaqs && (
        <section aria-labelledby="faq" class="faq-section">
          <h2 id="faq">Frequently asked questions</h2>
          <dl class="faq">
            {faqs.map((faq) => (
              <>
                <dt>{faq.question}</dt>
                <dd>{faq.answer}</dd>
              </>
            ))}
          </dl>
        </section>
      )}

      <footer class="page-footer">
        <p class="editorial-note">
          Listings on freeclinics.us are verified by our editorial team when they are
          added to the directory. Hours, services, and fees can change, so please call
          the clinic before you visit. If you spot something out of date,
          <a href="/contact/">please let us know</a>.
        </p>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  .page-intro { margin-bottom: var(--space-5); }
  .lede { font-size: 1.05rem; color: var(--color-text-muted); }

  .clinic-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .clinic-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
  }
  .clinic-card__name { margin: 0 0 var(--space-1); }
  .clinic-card__badge {
    display: inline-block;
    margin: 0 0 var(--space-2);
    padding: 0 var(--space-2);
    font-size: 0.85rem;
    font-weight: 600;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
  }
  .nearby-list { list-style: none; padding: 0; margin: 0 0 var(--space-3); }
  .nearby-list li { padding: var(--space-2) 0; border-bottom: 1px solid var(--color-border); }
  .nearby-list a { font-weight: 600; }
  .nearby-list__meta { display: block; font-size: 0.9rem; color: var(--color-text-muted); }
  .clinic-card__name a { text-decoration: none; }
  .clinic-card__name a:hover { text-decoration: underline; }
  .clinic-card__meta {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .clinic-card__details {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: 0.95rem;
  }
  .clinic-card__details dt {
    font-weight: 600;
    color: var(--color-text);
  }
  .clinic-card__details dd { margin: 0; }
  .clinic-card__details ul { margin: 0; padding-left: 1.1rem; }

  /* On narrow screens, stack the dl rows so labels & values are full-width
     instead of cramped into a 2-col grid. */
  @media (max-width: 520px) {
    .clinic-card { padding: var(--space-3) var(--space-4); }
    .clinic-card__details {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .clinic-card__details dt { margin-top: var(--space-2); }
  }

  .faq-section { margin-top: var(--space-6); }
  .faq dt { font-weight: 600; margin-top: var(--space-3); }
  .faq dd { margin: var(--space-1) 0 0; }
</style>
