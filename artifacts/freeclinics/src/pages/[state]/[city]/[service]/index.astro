---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { getState, getServiceDisplayName, toTitleCase } from '../../../../lib/constants';

// ---------------------------------------------------------------------------
// Routes
// ---------------------------------------------------------------------------
// Hardcoded for now. When the DB is wired in, replace this with a query that
// returns one entry per real (state, city, service) combination.
export function getStaticPaths() {
  return [
    { params: { state: 'texas',  city: 'houston',  service: 'blood-pressure-screening' } },
    { params: { state: 'oregon', city: 'portland', service: 'womens-health' } },
  ];
}

// ---------------------------------------------------------------------------
// Types — mirrors the columns in the real clinic dataset:
//   Company Name, Street, City, State, Zip Code, Phone, Website, Accepts,
//   Income, Fees, Languages Spoken, Services include, Hours, Service Area,
//   Lat, Long
// ---------------------------------------------------------------------------
interface Clinic {
  slug: string;             // generated
  name: string;             // ← Company Name
  streetAddress: string;    // ← Street (street line only)
  city: string;             // ← City
  stateAbbr: string;        // ← State (2-letter)
  postalCode: string;       // ← Zip Code
  phone: string;            // ← Phone
  website?: string;         // ← Website
  // Stored as comma-separated strings in the source dataset; split at load time.
  insuranceAccepted: string[]; // ← Accepts
  languages: string[];         // ← Languages Spoken
  services: string[];          // ← Services include
  feeStructure: string;        // ← Fees
  incomeEligibility?: string;  // ← Income
  hours: string;               // ← Hours
  serviceArea?: string;        // ← Service Area
  lat?: number;                // ← Lat
  long?: number;               // ← Long
}

interface FAQ {
  question: string;
  answer: string;
}

// ---------------------------------------------------------------------------
// Sample data — Portland, OR women's health
// ---------------------------------------------------------------------------
// Illustrative sample listings used to develop the template — websites and
// coordinates are real, but field values should be re-verified before they
// go live as part of the production dataset.
const SAMPLE_CLINICS: Clinic[] = [
  {
    slug: 'outside-in-clinic-portland',
    name: 'Outside In Community Health Clinic',
    streetAddress: '1132 SW 13th Ave',
    city: 'Portland',
    stateAbbr: 'OR',
    postalCode: '97205',
    phone: '(503) 535-3800',
    website: 'https://outsidein.org',
    insuranceAccepted: ['Oregon Health Plan (Medicaid)', 'Most commercial insurance', 'Uninsured welcome'],
    languages: ['English', 'Spanish'],
    services: [
      'Annual well-woman exams',
      'Pap smears & cervical cancer screening',
      'STI testing & treatment',
      'Birth control counseling and prescriptions',
      'Pregnancy testing',
    ],
    feeStructure: 'Sliding scale based on income; no one turned away for inability to pay',
    incomeEligibility: 'No income limit — everyone served on a sliding scale; lowest tier is free',
    hours: 'Mon–Thu 9:00 AM – 5:00 PM; Fri 9:00 AM – 1:00 PM',
    serviceArea: 'Tri-county Portland metro (Multnomah, Washington, Clackamas)',
    lat: 45.5208,
    long: -122.6850,
  },
  {
    slug: 'virginia-garcia-se-division-portland',
    name: 'Virginia Garcia Memorial Health Center — SE Division',
    streetAddress: '4209 SE Division St',
    city: 'Portland',
    stateAbbr: 'OR',
    postalCode: '97202',
    phone: '(503) 352-8800',
    website: 'https://virginiagarcia.org',
    insuranceAccepted: ['Oregon Health Plan', 'Medicare', 'Most commercial insurance', 'Uninsured patients'],
    languages: ['English', 'Spanish', 'Vietnamese'],
    services: [
      'Prenatal and postpartum care',
      'Family planning and contraception',
      'Pap smears and HPV testing',
      'Breast exams and mammogram referrals',
      'Menopause care',
    ],
    feeStructure: 'Sliding fee scale; discounts based on household size and income',
    incomeEligibility: 'Sliding scale available up to 200% of the Federal Poverty Level; everyone seen regardless',
    hours: 'Mon–Fri 8:00 AM – 5:00 PM; some evening appointments',
    serviceArea: 'Multnomah, Washington, and Yamhill counties',
    lat: 45.5046,
    long: -122.6213,
  },
  {
    slug: 'planned-parenthood-ne-portland',
    name: 'Planned Parenthood — NE Portland Health Center',
    streetAddress: '3727 NE Martin Luther King Jr Blvd',
    city: 'Portland',
    stateAbbr: 'OR',
    postalCode: '97212',
    phone: '(503) 775-0145',
    website: 'https://www.plannedparenthood.org/health-center/oregon/portland/97212/ne-portland-health-center-2540-91110',
    insuranceAccepted: ['Oregon Health Plan', 'Most commercial insurance', 'Uninsured patients'],
    languages: ['English', 'Spanish'],
    services: [
      'Birth control (pills, IUDs, implants, injections)',
      'STI testing and treatment',
      'Pap smears and cervical screening',
      'Breast exams',
      'Pregnancy testing and options counseling',
      'Emergency contraception',
    ],
    feeStructure: 'Sliding scale based on income; many services free for those who qualify',
    incomeEligibility: 'Free or reduced cost via Oregon Reproductive Health Program for those under 250% FPL',
    hours: 'Tue–Sat 9:00 AM – 5:30 PM',
    serviceArea: 'Open to all patients — no county restriction',
    lat: 45.5478,
    long: -122.6628,
  },
];

const SAMPLE_FAQS: FAQ[] = [
  {
    question: "Can I get a Pap smear in Portland if I don't have insurance?",
    answer:
      "Yes. Several Portland clinics — including Outside In, Virginia Garcia, and Planned Parenthood — offer Pap smears on a sliding-scale basis. The cost is determined by your household income, and some patients qualify for free screening through the Oregon Breast and Cervical Cancer Program.",
  },
  {
    question: "Do I need to be a US citizen to be seen at a free or low-cost clinic?",
    answer:
      "No. Federally Qualified Health Centers and most community clinics in Oregon serve patients regardless of immigration status. You will not be asked about citizenship in order to receive care, and most clinics do not require a Social Security number.",
  },
  {
    question: "What documents should I bring to my first appointment?",
    answer:
      "Most clinics ask for a photo ID (any government-issued ID is fine), proof of income for the most recent month (a pay stub, an unemployment letter, or a self-attestation form the clinic provides), and proof of address (a utility bill or piece of mail). If you have any insurance card, bring that too.",
  },
  {
    question: "Is birth control actually free at these clinics?",
    answer:
      "Often, yes. Birth control — including IUDs and implants — is fully covered by the Oregon Health Plan, and most low-cost clinics provide it free or near-free to uninsured patients who qualify under the sliding fee scale.",
  },
];

// ---------------------------------------------------------------------------
// Page-level data derived from params
// ---------------------------------------------------------------------------
const { state, city, service } = Astro.params;

const stateInfo      = getState(state);
const stateAbbr      = stateInfo?.abbr ?? state.toUpperCase();
const stateName      = stateInfo?.name ?? toTitleCase(state);
const titleCity      = toTitleCase(city);
const displayService = getServiceDisplayName(service);

const h1            = `Free & Low-Cost ${displayService} Clinics in ${titleCity}, ${stateAbbr}`;
const pageTitle     = `${h1} | freeclinics.us`;
const description   = `Find free and low-cost ${displayService.toLowerCase()} clinics in ${titleCity}, ${stateAbbr}. Verified listings with hours, fees, languages, and walk-in info for uninsured and underinsured patients.`;
const canonicalUrl  = `https://freeclinics.us/${state}/${city}/${service}/`;
const lastVerified  = '2026-05-01';

// ---------------------------------------------------------------------------
// JSON-LD structured data
// ---------------------------------------------------------------------------
const medicalBusinessJsonLd = SAMPLE_CLINICS.map((clinic) => {
  const data: Record<string, unknown> = {
    '@context': 'https://schema.org',
    '@type': 'MedicalBusiness',
    name: clinic.name,
    telephone: clinic.phone,
    address: {
      '@type': 'PostalAddress',
      streetAddress: clinic.streetAddress,
      addressLocality: clinic.city,
      addressRegion: clinic.stateAbbr,
      postalCode: clinic.postalCode,
      addressCountry: 'US',
    },
    availableService: clinic.services.map((s) => ({
      '@type': 'MedicalProcedure',
      name: s,
    })),
    url: `https://freeclinics.us/clinic/${clinic.slug}/`,
    priceRange: 'Free / Sliding scale',
  };
  if (typeof clinic.lat === 'number' && typeof clinic.long === 'number') {
    data.geo = {
      '@type': 'GeoCoordinates',
      latitude: clinic.lat,
      longitude: clinic.long,
    };
  }
  if (clinic.website) {
    data.sameAs = [clinic.website];
  }
  return data;
});

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: SAMPLE_FAQS.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---
<BaseLayout title={pageTitle} description={description} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    {medicalBusinessJsonLd.map((data) => (
      <script type="application/ld+json" set:html={JSON.stringify(data)} />
    ))}
    <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
  </Fragment>

  <main>
    <article>
      <header>
        <h1>{h1}</h1>
        <p>
          If you are uninsured or underinsured in {titleCity}, you can still get
          {' '}{displayService.toLowerCase()} care. The clinics listed below offer free
          or sliding-scale services — meaning what you pay is based on your income, not a
          fixed price. This page covers how that pricing actually works, what to bring to
          your first appointment, and a verified list of clinics in {titleCity},{' '}
          {stateName} that provide {displayService.toLowerCase()} services.
        </p>
      </header>

      <section aria-labelledby="how-it-works">
        <h2 id="how-it-works">How free and low-cost care works</h2>
        <p>
          A "sliding-scale fee" means the clinic adjusts what you pay based on your
          household income and family size. If you make very little, many visits and basic
          services are free. If you earn more, you might pay $20–$60 for a visit instead
          of the $200–$400 a private clinic would charge. You will be asked to fill out
          a short form so the clinic can place you on the right tier.
        </p>
        <p>
          The phrase "free clinic" can be misleading. Most "free" clinics are actually
          sliding-scale clinics — completely free for the lowest income tier, and very
          low cost for everyone else. A handful of clinics, usually volunteer-run, are
          truly free for all patients regardless of income. Both kinds are listed here.
        </p>
        <p>
          To get the lowest fee, bring three things to your first visit: a
          <strong> photo ID</strong> (any government-issued ID), <strong>proof of income</strong>
          {' '}(a recent pay stub, an unemployment award letter, or a clinic-provided
          self-attestation form if you are paid in cash), and <strong>proof of address</strong>
          {' '}(a utility bill or any piece of mail). If you do not have these, most
          clinics will still see you — they just may charge you their standard sliding-scale
          rate until you can verify income.
        </p>
      </section>

      <section aria-labelledby="clinic-list">
        <h2 id="clinic-list">{displayService} clinics in {titleCity}, {stateAbbr}</h2>
        <ol class="clinic-list">
          {SAMPLE_CLINICS.map((clinic) => (
            <li class="clinic-card">
              <h3>{clinic.name}</h3>
              <p class="clinic-meta">
                <span>{clinic.streetAddress}, {clinic.city}, {clinic.stateAbbr} {clinic.postalCode}</span> ·{' '}
                <a href={`tel:${clinic.phone.replace(/[^0-9+]/g, '')}`}>{clinic.phone}</a>
                {clinic.website && (
                  <>
                    {' '}·{' '}
                    <a href={clinic.website} rel="noopener" target="_blank">Website</a>
                  </>
                )}
              </p>

              <dl class="clinic-details">
                <dt>Services offered</dt>
                <dd>
                  <ul>
                    {clinic.services.map((s) => (<li>{s}</li>))}
                  </ul>
                </dd>

                <dt>Languages spoken</dt>
                <dd>{clinic.languages.join(', ')}</dd>

                <dt>Fee structure</dt>
                <dd>{clinic.feeStructure}</dd>

                {clinic.incomeEligibility && (
                  <>
                    <dt>Income eligibility</dt>
                    <dd>{clinic.incomeEligibility}</dd>
                  </>
                )}

                <dt>Insurance accepted</dt>
                <dd>{clinic.insuranceAccepted.join('; ')}</dd>

                <dt>Hours</dt>
                <dd>{clinic.hours}</dd>

                {clinic.serviceArea && (
                  <>
                    <dt>Service area</dt>
                    <dd>{clinic.serviceArea}</dd>
                  </>
                )}
              </dl>
            </li>
          ))}
        </ol>
      </section>

      <section aria-labelledby="faq">
        <h2 id="faq">Frequently asked questions</h2>
        <dl class="faq">
          {SAMPLE_FAQS.map((faq) => (
            <>
              <dt>{faq.question}</dt>
              <dd>{faq.answer}</dd>
            </>
          ))}
        </dl>
      </section>

      <footer class="page-footer">
        <p><strong>Listings last verified:</strong> {lastVerified}</p>
        <p class="editorial-note">
          Listings on freeclinics.us are reviewed and re-verified by our editorial team
          on a rolling basis. We confirm hours, services, and fee structure directly with
          each clinic. If you spot something out of date, please let us know.
        </p>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  main { max-width: 760px; margin: 0 auto; padding: 1.5rem 1rem 4rem; line-height: 1.55; color: #1a1a1a; font-family: system-ui, -apple-system, Segoe UI, sans-serif; }
  h1 { font-size: 1.85rem; line-height: 1.2; margin: 0 0 0.75rem; }
  h2 { font-size: 1.3rem; margin: 2.25rem 0 0.75rem; border-bottom: 1px solid #e5e5e5; padding-bottom: 0.25rem; }
  h3 { font-size: 1.1rem; margin: 0 0 0.25rem; }
  p { margin: 0.6rem 0; }
  .clinic-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 1.25rem; }
  .clinic-card { border: 1px solid #d9d9d9; border-radius: 6px; padding: 1rem 1.1rem; background: #fff; }
  .clinic-meta { color: #555; font-size: 0.95rem; margin: 0 0 0.6rem; }
  .clinic-details { display: grid; grid-template-columns: max-content 1fr; gap: 0.35rem 1rem; margin: 0; font-size: 0.95rem; }
  .clinic-details dt { font-weight: 600; color: #333; }
  .clinic-details dd { margin: 0; }
  .clinic-details ul { margin: 0; padding-left: 1.1rem; }
  .faq dt { font-weight: 600; margin-top: 1rem; }
  .faq dd { margin: 0.25rem 0 0; }
  .page-footer { margin-top: 2.5rem; padding-top: 1rem; border-top: 1px solid #e5e5e5; font-size: 0.9rem; color: #555; }
  .editorial-note { font-style: italic; }
</style>
