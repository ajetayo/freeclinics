---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import SlidingScaleExplainer from '../../../../components/SlidingScaleExplainer.astro';
import { getState, getServiceDisplayName, toTitleCase } from '../../../../lib/constants';
import type { Clinic } from '../../../../lib/types';
import { getClinicsByCityState, getClinicsByService } from '../../../../lib/clinics';
import { SERVICE_FAQS } from '../../../../data/service-faqs';
import phase1Combos from '../../../../data/phase1-service-locations.json';

// ---------------------------------------------------------------------------
// Routes — Phase 1
// ---------------------------------------------------------------------------
export function getStaticPaths() {
  const paths: Array<{
    params: { state: string; city: string; service: string };
    props: { clinics: Clinic[] };
  }> = [];

  for (const combo of phase1Combos as Array<{
    stateSlug: string;
    citySlug: string;
    serviceSlug: string;
  }>) {
    const cityClinics = getClinicsByCityState(combo.stateSlug, combo.citySlug);
    const matching = getClinicsByService(cityClinics, combo.serviceSlug);

    if (matching.length === 0) {
      console.warn(
        `[freeclinics] skipping empty combo: ${combo.stateSlug}/${combo.citySlug}/${combo.serviceSlug} ` +
          `(city has ${cityClinics.length} clinic(s), none match service)`,
      );
      continue;
    }

    paths.push({
      params: { state: combo.stateSlug, city: combo.citySlug, service: combo.serviceSlug },
      props: { clinics: matching },
    });
  }

  return paths;
}

const { state, city, service } = Astro.params;
const { clinics: rawClinics } = Astro.props as { clinics: Clinic[] };

const clinics = [...rawClinics].sort((a, b) => a.name.localeCompare(b.name));

const stateInfo      = getState(state);
const stateAbbr      = stateInfo?.abbr ?? state.toUpperCase();
const stateName      = stateInfo?.name ?? toTitleCase(state);
const titleCity      = toTitleCase(city);
const displayService = getServiceDisplayName(service);

const h1            = `Free & Low-Cost ${displayService} Clinics in ${titleCity}, ${stateAbbr}`;
const pageTitle     = `${h1} | freeclinics.us`;
const description   = `Find free and low-cost ${displayService.toLowerCase()} clinics in ${titleCity}, ${stateAbbr}. Verified listings with hours, fees, languages, and walk-in info for uninsured and underinsured patients.`;
const canonicalUrl  = `https://freeclinics.us/${state}/${city}/${service}/`;
const lastVerified  = '2026-05-01';

const faqs = SERVICE_FAQS[service] ?? [];
const hasFaqs = faqs.length > 0;

// ---------------------------------------------------------------------------
// JSON-LD structured data
// ---------------------------------------------------------------------------
// We deliberately emit only a lightweight ItemList here (one ListItem per
// clinic, in render order) rather than a full MedicalBusiness block per
// clinic. The canonical structured data for each clinic lives on its own
// /clinic/<slug>/ page; this list page just tells search engines the order
// and identity of the items shown.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: clinics.map((clinic, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: clinic.name,
    url: `https://freeclinics.us/clinic/${clinic.slug}/`,
  })),
};

const faqJsonLd = hasFaqs
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: { '@type': 'Answer', text: faq.answer },
      })),
    }
  : null;
---
<BaseLayout title={pageTitle} description={description} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
    {faqJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />
    )}
  </Fragment>

  <main class="site-main site-main--wide">
    <article>
      <p class="breadcrumb">
        <a href={`/${state}/${city}/`}>← All free clinics in {titleCity}, {stateAbbr}</a>
      </p>

      <header class="page-intro">
        <h1>{h1}</h1>
        <p class="lede">
          If you are uninsured or underinsured in {titleCity}, you can still get
          {' '}{displayService.toLowerCase()} care. The clinics listed below offer free
          or sliding-scale services — meaning what you pay is based on your income, not a
          fixed price. This page covers how that pricing actually works, what to bring to
          your first appointment, and a verified list of clinics in {titleCity},{' '}
          {stateName} that provide {displayService.toLowerCase()} services.
        </p>
      </header>

      <SlidingScaleExplainer />

      <section aria-labelledby="clinic-list">
        <h2 id="clinic-list">{displayService} clinics in {titleCity}, {stateAbbr}</h2>
        <ol class="clinic-list">
          {clinics.map((clinic) => (
            <li class="clinic-card">
              <h3 class="clinic-card__name">
                <a href={`/clinic/${clinic.slug}/`}>{clinic.name}</a>
              </h3>
              <p class="clinic-card__meta">
                <span>
                  {[clinic.streetAddress, clinic.city, clinic.stateAbbr].filter(Boolean).join(', ')}
                  {clinic.postalCode ? ` ${clinic.postalCode}` : ''}
                </span>
                {clinic.phone && (
                  <>
                    {' '}·{' '}
                    <a href={`tel:${clinic.phone.replace(/[^0-9+]/g, '')}`}>{clinic.phone}</a>
                  </>
                )}
                {clinic.website && (
                  <>
                    {' '}·{' '}
                    <a href={clinic.website} rel="noopener" target="_blank">Website</a>
                  </>
                )}
              </p>

              <dl class="clinic-card__details">
                {clinic.services.length > 0 && (<><dt>Services offered</dt><dd><ul>{clinic.services.map((s) => (<li>{s}</li>))}</ul></dd></>)}
                {clinic.languages.length > 0 && (<><dt>Languages spoken</dt><dd>{clinic.languages.join(', ')}</dd></>)}
                {clinic.feeStructure && (<><dt>Fee structure</dt><dd>{clinic.feeStructure}</dd></>)}
                {clinic.incomeEligibility && (<><dt>Income eligibility</dt><dd>{clinic.incomeEligibility}</dd></>)}
                {clinic.insuranceAccepted.length > 0 && (<><dt>Insurance accepted</dt><dd>{clinic.insuranceAccepted.join('; ')}</dd></>)}
                {clinic.hours && (<><dt>Hours</dt><dd>{clinic.hours}</dd></>)}
                {clinic.serviceArea && (<><dt>Service area</dt><dd>{clinic.serviceArea}</dd></>)}
              </dl>
            </li>
          ))}
        </ol>
      </section>

      {hasFaqs && (
        <section aria-labelledby="faq" class="faq-section">
          <h2 id="faq">Frequently asked questions</h2>
          <dl class="faq">
            {faqs.map((faq) => (
              <>
                <dt>{faq.question}</dt>
                <dd>{faq.answer}</dd>
              </>
            ))}
          </dl>
        </section>
      )}

      <footer class="page-footer">
        <p><span class="verified-line">Listings last verified:</span> {lastVerified}</p>
        <p class="editorial-note">
          Listings on freeclinics.us are reviewed and re-verified by our editorial team
          on a rolling basis. We confirm hours, services, and fee structure directly with
          each clinic. If you spot something out of date, please let us know.
        </p>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  .page-intro { margin-bottom: var(--space-5); }
  .lede { font-size: 1.05rem; color: var(--color-text-muted); }

  .clinic-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-4);
  }
  .clinic-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
  }
  .clinic-card__name { margin: 0 0 var(--space-1); }
  .clinic-card__name a { text-decoration: none; }
  .clinic-card__name a:hover { text-decoration: underline; }
  .clinic-card__meta {
    margin: 0 0 var(--space-3);
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  .clinic-card__details {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: 0.95rem;
  }
  .clinic-card__details dt {
    font-weight: 600;
    color: var(--color-text);
  }
  .clinic-card__details dd { margin: 0; }
  .clinic-card__details ul { margin: 0; padding-left: 1.1rem; }

  /* On narrow screens, stack the dl rows so labels & values are full-width
     instead of cramped into a 2-col grid. */
  @media (max-width: 520px) {
    .clinic-card { padding: var(--space-3) var(--space-4); }
    .clinic-card__details {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .clinic-card__details dt { margin-top: var(--space-2); }
  }

  .faq-section { margin-top: var(--space-6); }
  .faq dt { font-weight: 600; margin-top: var(--space-3); }
  .faq dd { margin: var(--space-1) 0 0; }
</style>
