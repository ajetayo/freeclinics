---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SlidingScaleExplainer from '../../../components/SlidingScaleExplainer.astro';
import { US_STATES, getServiceDisplayName, getState } from '../../../lib/constants';
import { getClinicsByCityState, getClinicsNearCity } from '../../../lib/clinics';
import { cityTitle } from '../../../lib/titles';
import { getServicePagesForCity } from '../../../lib/servicePages';
import { CLINIC_FILTERS, clinicFilterKeys } from '../../../lib/filters';
import cities from '../../../data/cities.json';
import phase1ServiceLocations from '../../../data/phase1-service-locations.json';

// ---------------------------------------------------------------------------
// Routes — one page per city in cities.json (~7,400)
// ---------------------------------------------------------------------------
type City = {
  stateSlug: string;
  citySlug: string;
  cityName: string;
  stateAbbr: string;
  clinicCount: number;
  servicePages: string[];
};

export function getStaticPaths() {
  const SERVICE_LOCATION_KEYS = new Set(
    (phase1ServiceLocations as Array<{ stateSlug: string; citySlug: string; serviceSlug: string }>).map(
      (combo) => `${combo.stateSlug}/${combo.citySlug}/${combo.serviceSlug}`,
    ),
  );

  // Skip rows with an empty citySlug/cityName — they'd produce a route with a
  // missing param and crash the build. Surface them so we can clean up the
  // data file later, but don't block the build over them.
  const validCities = (cities as City[]).filter((c) => {
    if (!c.citySlug || !c.cityName) {
      console.warn(
        `[freeclinics] skipping malformed city row in cities.json: ` +
          `${JSON.stringify(c)}`,
      );
      return false;
    }
    if (!(c.stateSlug in US_STATES)) {
      console.warn(
        `[freeclinics] skipping city with unknown state slug in cities.json: ` +
          `"${c.stateSlug}/${c.citySlug}"`,
      );
      return false;
    }
    return true;
  });

  return validCities.map((city) => {
    const actualCount = getClinicsByCityState(city.stateSlug, city.citySlug).length;
    if (city.clinicCount !== actualCount) {
      throw new Error(
        `cities.json: "${city.stateSlug}/${city.citySlug}" declares ` +
          `clinicCount=${city.clinicCount}, but getClinicsByCityState returned ` +
          `${actualCount} clinics. Update cities.json to match the dataset.`,
      );
    }
    for (const slug of city.servicePages) {
      const key = `${city.stateSlug}/${city.citySlug}/${slug}`;
      if (!SERVICE_LOCATION_KEYS.has(key)) {
        throw new Error(
          `cities.json: "${city.stateSlug}/${city.citySlug}" lists ` +
            `servicePages entry "${slug}", but no matching combo exists in ` +
            `phase1-service-locations.json. Add the combo or fix the slug.`,
        );
      }
    }
    return {
      params: { state: city.stateSlug, city: city.citySlug },
      props: { city },
    };
  });
}

const { city } = Astro.props as { city: City };

const stateInfo = getState(city.stateSlug);
const stateName = stateInfo?.name ?? city.stateAbbr;

const clinics = getClinicsByCityState(city.stateSlug, city.citySlug)
  .slice()
  .sort((a, b) => a.name.localeCompare(b.name));

const stateUrl     = `https://freeclinics.us/${city.stateSlug}/`;
const canonicalUrl = `https://freeclinics.us/${city.stateSlug}/${city.citySlug}/`;
const servicePages = getServicePagesForCity(city.stateSlug, city.citySlug);

// Filters (city pages with 4+ clinics): only filters that match at least one
// clinic here, each with its count.
const FILTER_MIN_CLINICS = 4;
const clinicKeys = new Map(clinics.map((c) => [c.slug, clinicFilterKeys(c)]));
const filterOptions = clinics.length >= FILTER_MIN_CLINICS
  ? CLINIC_FILTERS
      .map((f) => ({ key: f.key, label: f.label, count: clinics.filter((c) => clinicKeys.get(c.slug)!.includes(f.key)).length }))
      .filter((f) => f.count > 0)
  : [];
const filterLabel = new Map(CLINIC_FILTERS.map((f) => [f.key, f.label]));

// Small towns get a "Clinics near {City}" list so the page is useful beyond one or two listings.
const SMALL_CITY_MAX = 5;
const nearbyOutside = clinics.length <= SMALL_CITY_MAX
  ? getClinicsNearCity(city.stateSlug, city.citySlug)
  : [];

const pageTitle    = cityTitle(city.cityName, city.stateAbbr, clinics.length);
const description  = nearbyOutside.length > 0
  ? `${clinics.length} free and low-cost health ${clinics.length === 1 ? 'clinic' : 'clinics'} in ${city.cityName}, ${city.stateAbbr}, plus ${nearbyOutside.length} more within 25 miles — with phone numbers, hours and fees.`
  : `${clinics.length} free and low-cost health ${clinics.length === 1 ? 'clinic' : 'clinics'} in ${city.cityName}, ${city.stateAbbr}, with addresses, phone numbers, hours, fees and services for each.`;

// Full breadcrumb chain: Home → State → City.
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',         item: 'https://freeclinics.us/' },
    { '@type': 'ListItem', position: 2, name: stateName,      item: stateUrl },
    { '@type': 'ListItem', position: 3, name: city.cityName,  item: canonicalUrl },
  ],
};

// Lightweight ItemList alongside the breadcrumb — one ListItem per clinic
// shown on the page. The full MedicalClinic schema lives on each clinic's
// own detail page; we don't repeat it here.
const itemListJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: clinics.map((clinic, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: clinic.name,
    url: `https://freeclinics.us/clinic/${clinic.slug}/`,
  })),
};
---
<BaseLayout title={pageTitle} description={description} canonicalUrl={canonicalUrl}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(itemListJsonLd)} />
  </Fragment>

  <main class="site-main site-main--wide">
    <article>
      <p class="breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href={`/${city.stateSlug}/`}>{stateName}</a>
        <span aria-hidden="true">›</span>
        {city.cityName}
      </p>

      <header class="page-intro">
        <h1>Free &amp; Low-Cost Clinics in {city.cityName}, {city.stateAbbr}</h1>
        <p class="lede">
          This page lists {city.clinicCount} free and low-cost health{' '}
          {city.clinicCount === 1 ? 'clinic' : 'clinics'} in {city.cityName},{' '}
          {city.stateAbbr} — with verified addresses, hours, accepted insurance, and links
          to dedicated pages for the most-searched services in town.
        </p>
      </header>

      {servicePages.length > 0 && (
        <section aria-labelledby="browse-by-service">
          <h2 id="browse-by-service">Browse by service</h2>
          <ul class="service-chips">
            {servicePages.map((slug) => (
              <li>
                <a href={`/${city.stateSlug}/${city.citySlug}/${slug}/`} class="service-chip tap-target">
                  {getServiceDisplayName(slug)} in {city.cityName}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section aria-labelledby="all-clinics">
        <h2 id="all-clinics">All clinics in {city.cityName}</h2>
        {filterOptions.length > 1 && (
          <div class="clinic-filters" id="clinic-filters" hidden>
            <p class="clinic-filters__label" id="filters-label">Show only clinics that are:</p>
            <div class="clinic-filters__buttons" role="group" aria-labelledby="filters-label">
              {filterOptions.map((f) => (
                <button type="button" class="clinic-filters__btn" data-filter={f.key} aria-pressed="false">
                  {f.label} <span class="clinic-filters__count">({f.count})</span>
                </button>
              ))}
            </div>
            <p class="clinic-filters__status" id="filters-status" aria-live="polite"></p>
          </div>
        )}
        <ol class="clinic-list" id="city-clinic-list">
          {clinics.map((clinic) => {
            const addr = [clinic.streetAddress, clinic.city, clinic.stateAbbr]
              .filter(Boolean)
              .join(', ') + (clinic.postalCode ? ` ${clinic.postalCode}` : '');
            return (
              <li class="clinic-card" data-filters={clinicKeys.get(clinic.slug)!.join(' ')}>
                <h3 class="clinic-card__name">
                  <a href={`/clinic/${clinic.slug}/`}>{clinic.name}</a>
                </h3>
                {addr && <p class="clinic-card__meta">{addr}</p>}
                {clinicKeys.get(clinic.slug)!.length > 0 && (
                  <ul class="clinic-card__tags" aria-label="Features">
                    {clinicKeys.get(clinic.slug)!.map((k) => <li>{filterLabel.get(k)}</li>)}
                  </ul>
                )}
              </li>
            );
          })}
        </ol>
      </section>

      {nearbyOutside.length > 0 && (
        <section aria-labelledby="near-city">
          <h2 id="near-city">Clinics near {city.cityName}</h2>
          <p>Other free and low-cost clinics within 25 miles of {city.cityName}, nearest first.</p>
          <ol class="clinic-list">
            {nearbyOutside.map(({ clinic, miles }) => (
              <li class="clinic-card">
                <h3 class="clinic-card__name">
                  <a href={`/clinic/${clinic.slug}/`}>{clinic.name}</a>
                </h3>
                <p class="clinic-card__meta">{clinic.city}, {clinic.stateAbbr} · {miles.toFixed(1)} mi away</p>
              </li>
            ))}
          </ol>
        </section>
      )}

      <section aria-labelledby="other-options">
        <h2 id="other-options">Other ways to find care</h2>
        <SlidingScaleExplainer headingLevel={3} compact />
        <p>
          If none of the clinics above fit your situation, two other places to try are
          <strong> 211</strong> (dial 2-1-1 from any phone in the US for a referral to
          local social services, including health clinics) and your <strong>county
          health department</strong>, which often runs its own low-cost or sliding-scale
          clinics in addition to the ones listed here.
        </p>
      </section>

      <footer class="page-footer">
        <p class="editorial-note">
          Listings on freeclinics.us are verified by our editorial team when they are
          added to the directory. Hours, services, and fees can change, so please call
          the clinic before you visit. If you spot something out of date,
          <a href="/contact/">please let us know</a>.
        </p>
      </footer>
    </article>
  </main>
</BaseLayout>

<script>
  // City clinic filters: show clinics matching ALL selected filters. The
  // toolbar stays hidden without JavaScript, so the full list always shows.
  const box = document.getElementById('clinic-filters');
  const list = document.getElementById('city-clinic-list');
  if (box && list) {
    const buttons = [...box.querySelectorAll<HTMLButtonElement>('.clinic-filters__btn')];
    const cards = [...list.querySelectorAll<HTMLElement>(':scope > .clinic-card')];
    const status = document.getElementById('filters-status')!;
    const apply = () => {
      const active = buttons.filter((b) => b.getAttribute('aria-pressed') === 'true').map((b) => b.dataset.filter!);
      let shown = 0;
      for (const card of cards) {
        const keys = (card.dataset.filters ?? '').split(' ');
        const show = active.every((k) => keys.includes(k));
        card.hidden = !show;
        if (show) shown++;
      }
      status.replaceChildren();
      if (active.length > 0) {
        status.append(shown === 0
          ? 'No clinics here match all of those. '
          : `Showing ${shown} of ${cards.length} clinics. `);
        const clear = document.createElement('button');
        clear.type = 'button';
        clear.className = 'clinic-filters__clear';
        clear.textContent = 'Clear filters';
        clear.addEventListener('click', () => { buttons.forEach((b) => b.setAttribute('aria-pressed', 'false')); apply(); });
        status.append(clear);
      }
    };
    for (const b of buttons) {
      b.addEventListener('click', () => {
        b.setAttribute('aria-pressed', b.getAttribute('aria-pressed') === 'true' ? 'false' : 'true');
        apply();
      });
    }
    box.hidden = false;
  }
</script>

<style>
  /* Created by the filter script, so outside Astro's scoped styles. */
  :global(.clinic-filters__clear) {
    background: none; border: none; padding: var(--space-1) 0; min-height: 44px;
    color: var(--color-primary); font-weight: 600; text-decoration: underline; cursor: pointer;
  }
  .page-intro { margin-bottom: var(--space-5); }
  .lede { font-size: 1.05rem; color: var(--color-text-muted); }

  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary-dark); }

  .service-chips {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .service-chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--space-2) var(--space-4);
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    color: var(--color-primary);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .service-chip:hover {
    background: var(--color-surface);
    border-color: var(--color-primary);
    color: var(--color-primary-dark);
  }

  .clinic-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: var(--space-3);
  }
  .clinic-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-3) var(--space-4);
  }
  .clinic-card__name { margin: 0 0 var(--space-1); font-size: 1.02rem; }
  .clinic-card__name a { text-decoration: none; }
  .clinic-card__name a:hover { text-decoration: underline; }
  .clinic-card__meta { margin: 0; color: var(--color-text-muted); font-size: 0.9rem; }
  .clinic-card__tags {
    list-style: none; padding: 0; margin: var(--space-2) 0 0;
    display: flex; flex-wrap: wrap; gap: var(--space-1);
  }
  .clinic-card__tags li {
    font-size: 0.8rem; font-weight: 600; padding: 0 var(--space-2);
    border: 1px solid var(--color-border); border-radius: 999px; color: var(--color-text);
  }
  .clinic-filters { margin: 0 0 var(--space-4); }
  .clinic-filters__label { margin: 0 0 var(--space-2); font-weight: 600; }
  .clinic-filters__buttons { display: flex; flex-wrap: wrap; gap: var(--space-2); }
  .clinic-filters__btn {
    min-height: 44px; padding: 0 var(--space-3); font-size: 0.95rem; cursor: pointer;
    background: var(--color-bg); color: var(--color-text);
    border: 1px solid var(--color-border); border-radius: 999px;
  }
  .clinic-filters__btn[aria-pressed="true"] {
    background: var(--color-primary); color: #fff; border-color: var(--color-primary);
  }
  .clinic-filters__count { opacity: 0.8; }
  .clinic-filters__status { margin: var(--space-2) 0 0; font-size: 0.9rem; color: var(--color-text-muted); }
  .clinic-card[hidden] { display: none; }
</style>
