---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SlidingScaleExplainer from '../../../components/SlidingScaleExplainer.astro';
import { getClinicBySlug, getClinicsByService, getNearbyClinics } from '../../../lib/clinics';
import { US_STATES, getState, getServiceDisplayName } from '../../../lib/constants';
import { clinicTitle, clinicDescription } from '../../../lib/titles';
import { hoursLabel, hoursLines, hasTimes, openingHoursSpecification } from '../../../lib/hours';
import type { Clinic } from '../../../lib/types';
import clinicSlugs from '../../../data/clinic-slugs.json';
import cities from '../../../data/cities.json';
import noindexClinics from '../../../data/noindex-clinics.json';

// Listings kept on the site (city and nearby lists still link to them) but
// excluded from search: see src/data/noindex-clinics.json for each reason.
const NOINDEX_SLUGS = new Set((noindexClinics as Array<{ slug: string }>).map((c) => c.slug));

// Set of known "state/city" keys from cities.json. Every clinic's
// (stateSlug, citySlug) should resolve to a real city hub now that we have
// full national coverage — this guard surfaces any data drift instead of
// silently emitting a broken backlink.
const CITY_KEYS = new Set(
  (cities as Array<{ stateSlug: string; citySlug: string }>).map(
    (c) => `${c.stateSlug}/${c.citySlug}`,
  ),
);

// "state/city" → that city's service-page slugs, for the "Find care nearby" links.
const CITY_SERVICE_PAGES = new Map(
  (cities as Array<{ stateSlug: string; citySlug: string; servicePages: string[] }>).map(
    (c) => [`${c.stateSlug}/${c.citySlug}`, c.servicePages],
  ),
);

// ---------------------------------------------------------------------------
// Routes — one page per slug in clinic-slugs.json (~18,800)
// ---------------------------------------------------------------------------
export function getStaticPaths() {
  const routes: Array<{ params: { slug: string }; props: { clinic: Clinic } }> = [];
  for (const slug of clinicSlugs as string[]) {
    const clinic = getClinicBySlug(slug);
    if (!clinic) {
      throw new Error(
        `clinic/[slug]: clinic-slugs.json references "${slug}" but ` +
          `getClinicBySlug returned undefined. Either remove the slug from ` +
          `clinic-slugs.json or add the clinic to clinics.json.`,
      );
    }
    // Skip clinics in non-US-state jurisdictions (e.g. Palau). They aren't in
    // scope for this US directory and would dead-end on a missing state hub.
    if (!(clinic.stateSlug in US_STATES)) {
      console.warn(
        `[freeclinics] skipping clinic with unknown state slug: ` +
          `"${slug}" (state="${clinic.stateSlug}")`,
      );
      continue;
    }
    routes.push({ params: { slug }, props: { clinic } });
  }
  return routes;
}

const { clinic } = Astro.props as { clinic: Clinic };

const stateInfo = getState(clinic.stateSlug);
const stateName = stateInfo?.name ?? clinic.stateAbbr;

// City hub URL — only emitted if the (state, city) pair is actually in
// cities.json. With full national coverage this should always be true; the
// fallback keeps us safe if a single clinic ever has a mismatched citySlug.
const cityHubHref  = CITY_KEYS.has(`${clinic.stateSlug}/${clinic.citySlug}`)
  ? `/${clinic.stateSlug}/${clinic.citySlug}/`
  : null;
const stateHref    = `/${clinic.stateSlug}/`;

const nearby = getNearbyClinics(clinic);
// City service pages for services this clinic offers (only cities that have them).
const cityServiceLinks = (CITY_SERVICE_PAGES.get(`${clinic.stateSlug}/${clinic.citySlug}`) ?? [])
  .filter((slug) => getClinicsByService([clinic], slug).length > 0)
  .map((slug) => ({ href: `/${clinic.stateSlug}/${clinic.citySlug}/${slug}/`, label: getServiceDisplayName(slug) }));
const formatMiles = (miles: number) => (miles < 0.1 ? 'same location' : `${miles.toFixed(1)} mi`);

const hoursCheckedLabel = clinic.hoursCheckedDate
  ? new Date(`${clinic.hoursCheckedDate}T00:00:00Z`).toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' })
  : null;

const hoursText    = hoursLabel(clinic.hours);
const hoursHaveTimes = hasTimes(clinic.hours);
const pageTitle    = clinicTitle(clinic);
const description  = clinicDescription(clinic, hoursText);
const canonicalUrl = `https://freeclinics.us/clinic/${clinic.slug}/`;

const directionsHref = (() => {
  if (typeof clinic.lat === 'number' && typeof clinic.long === 'number') {
    return `https://www.google.com/maps/dir/?api=1&destination=${clinic.lat},${clinic.long}`;
  }
  const addressParts = [clinic.streetAddress, clinic.city, clinic.stateAbbr, clinic.postalCode].filter(Boolean);
  if (addressParts.length === 0) return null;
  return `https://www.google.com/maps/dir/?api=1&destination=${encodeURIComponent(addressParts.join(', '))}`;
})();

const fullAddress = [clinic.streetAddress, clinic.city, clinic.stateAbbr]
  .filter(Boolean)
  .join(', ') + (clinic.postalCode ? ` ${clinic.postalCode}` : '');

// ---------------------------------------------------------------------------
// JSON-LD: MedicalClinic + BreadcrumbList
// ---------------------------------------------------------------------------
const medicalClinicJsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'MedicalClinic',
  name: clinic.name,
  address: {
    '@type': 'PostalAddress',
    streetAddress: clinic.streetAddress ?? undefined,
    addressLocality: clinic.city,
    addressRegion: clinic.stateAbbr,
    postalCode: clinic.postalCode ?? undefined,
    addressCountry: 'US',
  },
  url: canonicalUrl,
};
if (clinic.feeStructure) {
  const fs = clinic.feeStructure.toLowerCase();
  let priceRange: string | null = null;
  if (fs.includes('free') && fs.includes('sliding')) priceRange = 'Free / Sliding scale';
  else if (fs.includes('sliding'))                   priceRange = 'Sliding scale';
  else if (fs.includes('free'))                      priceRange = 'Free';
  else if (fs.includes('low cost') || fs.includes('low-cost')) priceRange = 'Low cost';
  if (priceRange) medicalClinicJsonLd.priceRange = priceRange;
}
if (clinic.phone) medicalClinicJsonLd.telephone = clinic.phone;
if (typeof clinic.lat === 'number' && typeof clinic.long === 'number') {
  medicalClinicJsonLd.geo = {
    '@type': 'GeoCoordinates',
    latitude: clinic.lat,
    longitude: clinic.long,
  };
}
if (clinic.website) medicalClinicJsonLd.sameAs = [clinic.website];
const openingHours = openingHoursSpecification(clinic.hours);
if (openingHours) medicalClinicJsonLd.openingHoursSpecification = openingHours;
if (clinic.services.length > 0) {
  medicalClinicJsonLd.availableService = clinic.services.map((s) => ({
    '@type': 'MedicalProcedure',
    name: s,
  }));
}
const addr = medicalClinicJsonLd.address as Record<string, unknown>;
for (const k of Object.keys(addr)) if (addr[k] === undefined) delete addr[k];

// Full breadcrumb chain: Home → State → City → Clinic name.
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home',      item: 'https://freeclinics.us/' },
    { '@type': 'ListItem', position: 2, name: stateName,   item: `https://freeclinics.us${stateHref}` },
    ...(cityHubHref
      ? [{ '@type': 'ListItem', position: 3, name: clinic.city, item: `https://freeclinics.us${cityHubHref}` }]
      : []),
    { '@type': 'ListItem', position: cityHubHref ? 4 : 3, name: clinic.name, item: canonicalUrl },
  ],
};
---
<BaseLayout title={pageTitle} description={description} canonicalUrl={canonicalUrl} noindex={NOINDEX_SLUGS.has(clinic.slug)}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(medicalClinicJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <main class="site-main">
    <article>
      <p class="breadcrumb">
        <a href="/">Home</a>
        <span aria-hidden="true">›</span>
        <a href={stateHref}>{stateName}</a>
        {cityHubHref && (
          <>
            <span aria-hidden="true">›</span>
            <a href={cityHubHref}>{clinic.city}</a>
          </>
        )}
        <span aria-hidden="true">›</span>
        {clinic.name}
      </p>

      <header class="page-intro">
        <h1>{clinic.name}</h1>
        <p class="lede">
          {clinic.name} is a free or low-cost health clinic in {clinic.city},{' '}
          {stateName}. This page covers the services it offers, who is
          eligible, what it costs, and how to visit.
        </p>
      </header>

      {/* Visit & contact — emphasized callout box. The most actionable info on
          the page, so it gets a bordered, slightly stronger treatment. */}
      <section aria-labelledby="visit-contact" class="visit-contact">
        <h2 id="visit-contact" class="visit-contact__title">Visit &amp; contact</h2>
        <dl class="visit-contact__details">
          {(clinic.streetAddress || clinic.city) && (
            <>
              <dt>Address</dt>
              <dd>
                {fullAddress}
                {directionsHref && (
                  <>
                    {' '}—{' '}
                    <a href={directionsHref} rel="noopener" target="_blank" data-track="get_directions" data-clinic={clinic.slug}>Get directions</a>
                  </>
                )}
              </dd>
            </>
          )}
          {clinic.phone && (
            <>
              <dt>Phone</dt>
              <dd><a href={`tel:${clinic.phone.replace(/[^0-9+]/g, '')}`} data-track="phone_call" data-clinic={clinic.slug}>{clinic.phone}</a></dd>
            </>
          )}
          {clinic.website && (
            <>
              <dt>Website</dt>
              <dd><a href={clinic.website} rel="noopener" target="_blank" data-track="clinic_website_click" data-clinic={clinic.slug}>{clinic.website}</a></dd>
            </>
          )}
          <dt>Hours</dt>
          <dd>
            {hoursLines(clinic.hours).map((line, i) => (<>{i > 0 && <br />}{line}</>))}
            {hoursCheckedLabel && clinic.hoursSource && (
              <span class="hours-note">
                Hours checked {hoursCheckedLabel} on the clinic's{' '}
                <a href={clinic.hoursSource} rel="nofollow noopener" target="_blank">official website</a>.
              </span>
            )}
            {!hoursHaveTimes && clinic.phone && (
              <span class="hours-note">
                Exact times aren't listed —{' '}
                <a href={`tel:${clinic.phone.replace(/[^0-9+]/g, '')}`} data-track="phone_call" data-clinic={clinic.slug}>call {clinic.phone}</a>{' '}
                to confirm before you go.
              </span>
            )}
          </dd>
        </dl>
      </section>

      {clinic.services.length > 0 && (
        <section aria-labelledby="services">
          <h2 id="services">Services offered</h2>
          <ul class="services-list">
            {clinic.services.map((s) => (<li>{s}</li>))}
          </ul>
        </section>
      )}

      <section aria-labelledby="eligibility-cost">
        <h2 id="eligibility-cost">Eligibility &amp; cost</h2>
        <dl class="info-details">
          {clinic.feeStructure && (<><dt>Fee structure</dt><dd>{clinic.feeStructure}</dd></>)}
          {clinic.incomeEligibility && (<><dt>Income eligibility</dt><dd>{clinic.incomeEligibility}</dd></>)}
        </dl>
        <SlidingScaleExplainer headingLevel={3} compact />
      </section>

      {clinic.languages.length > 0 && (
        <section aria-labelledby="languages">
          <h2 id="languages">Languages spoken</h2>
          <p>{clinic.languages.join(', ')}</p>
        </section>
      )}

      {clinic.insuranceAccepted.length > 0 && (
        <section aria-labelledby="insurance">
          <h2 id="insurance">Insurance accepted</h2>
          <p>{clinic.insuranceAccepted.join('; ')}</p>
        </section>
      )}

      {clinic.serviceArea && (
        <section aria-labelledby="service-area">
          <h2 id="service-area">Service area</h2>
          <p>{clinic.serviceArea}</p>
        </section>
      )}

      {(nearby.length > 0 || cityHubHref || cityServiceLinks.length > 0) && (
        <section aria-labelledby="nearby-clinics" class="nearby">
          <h2 id="nearby-clinics">Nearby clinics</h2>
          {nearby.length > 0 ? (
            <ul class="nearby__list">
              {nearby.map(({ clinic: other, miles }) => (
                <li class="nearby__item">
                  <a href={`/clinic/${other.slug}/`} class="nearby__name">{other.name}</a>
                  <span class="nearby__meta">
                    {other.city}, {other.stateAbbr} · {formatMiles(miles)}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <p>We don't list other clinics within 25 miles of this one.</p>
          )}
          {(cityHubHref || cityServiceLinks.length > 0) && (
            <p class="nearby__more">
              {cityHubHref && (
                <a href={cityHubHref}>All free and low-cost clinics in {clinic.city}</a>
              )}
              {cityServiceLinks.map((s) => (
                <>
                  {' · '}
                  <a href={s.href}>{s.label} in {clinic.city}</a>
                </>
              ))}
            </p>
          )}
        </section>
      )}

      <footer class="page-footer">
        <p class="editorial-note">
          Listings on freeclinics.us are verified by our editorial team when they are
          added to the directory. Hours, services, and fees can change, so please call
          the clinic before you visit. If you spot something out of date,
          <a href="/contact/">please let us know</a>.
        </p>
      </footer>
    </article>
  </main>
</BaseLayout>

<style>
  .page-intro { margin-bottom: var(--space-5); }
  .lede { font-size: 1.05rem; color: var(--color-text-muted); }

  .breadcrumb a { color: var(--color-text-muted); }
  .breadcrumb a:hover { color: var(--color-primary-dark); }

  .visit-contact {
    background: var(--color-bg);
    border: 2px solid var(--color-border);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-5);
    margin: var(--space-5) 0 var(--space-6);
    box-shadow: 0 1px 0 var(--color-border);
  }
  .visit-contact__title {
    margin: 0 0 var(--space-3);
    border-bottom: 1px solid var(--color-border);
    padding-bottom: var(--space-2);
  }
  .visit-contact__details {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0;
    font-size: 0.97rem;
  }
  .visit-contact__details dt { font-weight: 600; color: var(--color-text); }
  .visit-contact__details dd { margin: 0; }
  .nearby__list {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
  }
  .nearby__item {
    padding: var(--space-2) 0;
    border-bottom: 1px solid var(--color-border);
  }
  .nearby__name {
    display: block;
    padding: var(--space-1) 0;
    font-weight: 600;
    color: var(--color-primary);
  }
  .nearby__meta {
    display: block;
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }
  .nearby__more { line-height: 1.9; }
  .hours-note {
    display: block;
    margin-top: var(--space-1);
    font-size: 0.9rem;
    color: var(--color-text-muted);
  }

  .services-list { margin: 0 0 var(--space-4); padding-left: 1.2rem; }

  .info-details {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--space-2) var(--space-4);
    margin: 0 0 var(--space-3);
    font-size: 0.97rem;
  }
  .info-details dt { font-weight: 600; }
  .info-details dd { margin: 0; }

  @media (max-width: 520px) {
    .visit-contact { padding: var(--space-3) var(--space-4); }
    .visit-contact__details,
    .info-details {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .visit-contact__details dt,
    .info-details dt { margin-top: var(--space-2); }
  }
</style>
