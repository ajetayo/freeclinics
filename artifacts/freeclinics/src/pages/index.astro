---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Free Clinics US — Find Free and Low-Cost Clinics Near You"
  description="freeclinics.us is a directory of free and low-cost health clinics across the United States. Search by state, city, and service."
  canonicalUrl="https://freeclinics.us/"
>
  <main class="site-main">
    <h1>Free &amp; low-cost clinics across the United States</h1>
    <p class="lede">
      A directory of free and sliding-scale health clinics, with verified
      addresses, hours, services, and fee information for uninsured and
      underinsured patients.
    </p>
  </main>
</BaseLayout>

<style>
  .lede { font-size: 1.06rem; color: var(--color-text-muted); }
</style>
